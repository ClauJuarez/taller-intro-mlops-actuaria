    "    f\"pero producción requiere {VERSION_ESPERADA}. Ejecuta: pip install -r requirements.txt\"\n",
    ")\n",
    "print(f\"Entorno validado: scikit-learn {sklearn.__version__}\")\n",
    "\n",
    "# Detectar automáticamente la raíz del repositorio\n",
    "BASE_DIR = Path.cwd().parent if Path.cwd().name == \"notebooks\" else Path.cwd()\n",
    "DATA_PATH = BASE_DIR / \"data\" / \"telco_train_alumnos.csv\"\n",
    "MODEL_PATH = BASE_DIR / \"models\" / \"modelo_retencion.joblib\"\n",
    "\n",
    "assert DATA_PATH.exists(), f\"No se encontró el archivo de datos en: {DATA_PATH}\"\n",
    "print(f\" Ruta de datos detectada: {DATA_PATH}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Librerías de modelado y carga de datos\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import (\n",
    "    roc_auc_score,\n",
    "    brier_score_loss,\n",
    "    classification_report,\n",
    "    roc_curve\n",
    ")\n",
    "\n",
    "df = pd.read_csv(DATA_PATH)\n",
    "print(f\"Dimensiones de la base: {df.shape}\")\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Definición de Variables y Target\n",
    "Separamos las covariables ($X$) de la variable objetivo ($y$). `customerID` es un identificador sin valor predictivo."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X = df.drop(columns=[\"customerID\", \"Churn\"])\n",
    "y = df[\"Churn\"]\n",
    "\n",
    "num_cols = [\"tenure\", \"MonthlyCharges\", \"TotalCharges\"]\n",
    "cat_cols = [c for c in X.columns if c not in num_cols]\n",
    "\n",
    "print(f\"Variables numéricas ({len(num_cols)}): {num_cols}\")\n",
    "print(f\"Variables categóricas ({len(cat_cols)}): {cat_cols}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### TODO 1: Partición Train / Test Estratificada\n",
    "Divide los datos en 80% entrenamiento y 20% validación asegurando que ambas particiones conserven la misma proporción de cancelaciones (`stratify=y`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# TODO 1: Completa los parámetros test_size y stratify\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, \n",
    "    y, \n",
    "    test_size=None,      # <--- Completa aquí\n",
    "    stratify=None,       # <--- Completa aquí\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "print(f\"Entrenamiento: {len(X_train)} filas | Tasa Churn: {y_train.mean():.2%}\")\n",
    "print(f\"Validación:    {len(X_test)} filas | Tasa Churn: {y_test.mean():.2%}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Construcción del Pipeline de Preprocesamiento\n",
    "Escalamos las variables numéricas y codificamos las variables categóricas con `OneHotEncoder`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        (\"num\", StandardScaler(), num_cols),\n",
    "        (\"cat\", OneHotEncoder(handle_unknown=\"ignore\", drop=\"first\"), cat_cols)\n",
    "    ]\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### TODO 2: Modelo y Pipeline Completo\n",
    "Configura una Regresión Logística con balanceo automático de clases (`class_weight=\"balanced\"`) y ensambla el `Pipeline`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# TODO 2: Configura el clasificador con class_weight=\"balanced\"\n",
    "modelo_base = LogisticRegression(\n",
    "    max_iter=1000, \n",
    "    class_weight=None,   # <--- Completa aquí\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "pipeline_completo = Pipeline(steps=[\n",
    "    (\"preprocesamiento\", preprocessor),\n",
    "    (\"clasificador\", modelo_base)\n",
    "])\n",
    "\n",
    "pipeline_completo.fit(X_train, y_train)\n",
    "print(\"¡Modelo entrenado exitosamente!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### TODO 3: Evaluación de Métricas Actuariales\n",
    "Calcula el **ROC-AUC** (discriminación) y el **Brier Score** (calibración probabilística) sobre el conjunto de validación (`X_test`, `y_test`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extraer probabilidades estimadas de fuga (clase 1)\n",
    "y_prob_test = pipeline_completo.predict_proba(X_test)[:, 1]\n",
    "\n",
    "# TODO 3: Calcular métricas base para el monitoreo\n",
    "auc_score = None      # <--- Usa roc_auc_score(y_test, y_prob_test)\n",
    "brier_score = None    # <--- Usa brier_score_loss(y_test, y_prob_test)\n",
    "\n",
    "print(\"--- RESULTADOS DE VALIDACIÓN ---\")\n",
    "print(f\"ROC-AUC Base:    {auc_score:.4f}  (Línea base para producción)\")\n",
    "print(f\"Brier Score:     {brier_score:.4f} (Idealmente cercano a 0)\")\n",
    "\n",
    "y_pred_default = (y_prob_test >= 0.50).astype(int)\n",
    "print(\"\\nReporte de Clasificación (Corte 0.50):\")\n",
    "print(classification_report(y_test, y_pred_default))"
   ]
  },
  {
   "cell_type": "markdown",
