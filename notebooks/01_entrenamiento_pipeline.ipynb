    "5. Exportar el artefacto `models/modelo_retencion.joblib` para desplegarlo con Git."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 0. Verificación de entorno y rutas locales\n",
    "from pathlib import Path\n",
    "import sklearn\n",
    "import joblib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
